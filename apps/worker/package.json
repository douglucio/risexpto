{
  "name": "@risexpto/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/root-env.mjs tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ../../scripts/root-env.mjs node dist/main.js",
    "smoke:testnet": "tsx src/binance-testnet-smoke.ts",
    "preflight:testnet": "tsx src/binance-testnet-readiness.ts",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.config.ts src/*.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  },
  "dependencies": {
    "@risexpto/binance-connection": "workspace:*",
    "@risexpto/database": "workspace:*",
    "@risexpto/live-execution": "workspace:*",
    "@risexpto/market-data": "workspace:*",
    "@risexpto/risk-engine": "workspace:*",
    "@risexpto/strategy-dca": "workspace:*",
    "bullmq": "5.63.0",
    "decimal.js": "10.6.0"
  }
}
