# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://risexpto:change-me-locally@localhost:5432/risexpto?schema=public
REDIS_URL=redis://localhost:6379
WORKER_QUEUE_NAME=risexpto
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=risexpto
KEYCLOAK_CLIENT_ID=risexpto-web
KEYCLOAK_API_AUDIENCE=risexpto-api
AUTH_BASE_URL=http://localhost:3000
AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes
POSTGRES_DB=risexpto
POSTGRES_USER=risexpto
POSTGRES_PASSWORD=change-me-locally
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally
BINANCE_CREDENTIAL_MASTER_KEY=replace-with-32-byte-base64url-key
BINANCE_TRADING_ENVIRONMENT=TESTNET
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
# Reserved for a future, explicitly approved production gate. Never used by the current application.
BINANCE_PRODUCTION_BASE_URL=https://api.binance.com
LIVE_TRADING_ENABLED=false
RUN_BINANCE_TESTNET_SMOKE=false
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_SMOKE_ORDER=false
BINANCE_TESTNET_SMOKE_SYMBOL=BTCUSDT
BINANCE_TESTNET_SMOKE_QUOTE_AMOUNT=5
BINANCE_MARKET_DATA_BASE_URL=https://api.binance.com
MARKET_DATA_INTERVAL_MS=60000
MARKET_DATA_MAX_AGE_MS=120000
PAPER_SCHEDULER_INTERVAL_MS=10000
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_TEST_PRICE_STARTER=price_test_starter
STRIPE_TEST_PRICE_PRO=price_test_pro
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing?checkout=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing
