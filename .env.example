# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
DATABASE_URL=postgresql://risexpto:change-me-locally@localhost:5432/risexpto?schema=public
REDIS_URL=redis://localhost:6379
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=risexpto
KEYCLOAK_CLIENT_ID=risexpto-web
KEYCLOAK_API_AUDIENCE=risexpto-api
AUTH_BASE_URL=http://localhost:3000
AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes
POSTGRES_DB=risexpto
POSTGRES_USER=risexpto
POSTGRES_PASSWORD=change-me-locally
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally
BINANCE_CREDENTIAL_MASTER_KEY=replace-with-32-byte-base64url-key
BINANCE_BASE_URL=https://api.binance.com
